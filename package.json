{
  "name": "wadhaya-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --input-type=module -e \"import('node:fs').then(fs => fs.rmSync('dist/_redirects', { force: true }))\"",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply wadhaya-store-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wadhaya-store-db --remote"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^6.4.5"
  }
}
