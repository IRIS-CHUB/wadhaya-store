{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wadhaya-store",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wadhaya-store-db"
    }
  ]
}
